{% doc %}
  @prompt
    Create a “Our Team of Experts” section with a clean, modern medical design.
    
    SECTION HEADER:
    - Full-width section with a neutral, clean background (white or very light gray).
    - Add a centered heading group at the top:
      - Eyebrow label: “OUR TEAM OF EXPERTS”
      - Large headline: “Experienced Professionals Dedicated to Scientific Excellence”
      - Subheading paragraph describing expertise, accuracy, and peptide testing excellence.
    
    TOP FEATURED MEMBER LAYOUT (Two-Column):
    - Create a two-column layout beneath the heading.
    - LEFT COLUMN: A large portrait image of the lead scientist or director, with rounded corners (20–25px).
    - RIGHT COLUMN:
      - Expert’s name in bold (e.g., “Dr. Charles Xavier, PhD”)
      - Title line below in blue or accent color (e.g., “DIRECTOR OF PEPTIDE TESTING”)
      - A detailed paragraph about their background, expertise, and role in peptide testing and scientific leadership.
      - Use clean medical typography and comfortable line spacing.
    
    DIVIDER:
    - Add generous spacing before the next section. Use a light divider or restful negative space.
    
    MEET OUR SPECIALISTS SECTION (Card Row):
    - Add a new subheading centered: 
      - Eyebrow label: “OUR SPECIALISTS”
      - Large headline: “Meet Our Team”
    - Below the heading, create a row of three evenly spaced profile cards.
    
    CARD DESIGN:
    - White card background
    - Soft round corners (20–25px)
    - Subtle shadow for depth
    - Vertical layout with image above text
    
    CARD CONTENT:
    Each card should include:
    - Professional portrait with a neutral or soft clinical background
    - Name in bold (e.g., “Ororo Munroe, PhD”)
    - Title line below (e.g., “LEAD OF TESTING”)
    - Optional short description or placeholder line
    - “View Profile →” link at the bottom
    
    LAYOUT & SPACING:
    - Equal spacing between cards
    - Generous padding above and below
    - Clean, premium healthcare aesthetic
    - Balanced and modern layout similar to high-end medical or laboratory websites
    
    OVERALL TONE:
    - Scientific, trustworthy, modern, and professional
    - Inspired by premium 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-team-experts-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-team-experts-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-team-experts-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-team-experts-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    color: {{ block.settings.eyebrow_color }};
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 16px;
    display: block;
  }

  .ai-team-experts-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_size }}px;
    color: {{ block.settings.headline_color }};
    margin: 0 0 24px;
    line-height: 1.2;
  }

  .ai-team-experts-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    max-width: 800px;
    margin: 0 auto;
  }

  .ai-team-experts-featured-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.featured_gap }}px;
    align-items: center;
    margin-bottom: {{ block.settings.divider_spacing }}px;
  }

  .ai-team-experts-featured-image-{{ ai_gen_id }} {
    width: 500px;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-team-experts-featured-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .ai-team-experts-featured-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 3 / 4;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-team-experts-featured-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-team-experts-featured-content-{{ ai_gen_id }} {
    padding: 0 20px;
  }

  .ai-team-experts-featured-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.featured_name_size }}px;
    color: {{ block.settings.headline_color }};
    font-weight: 700;
    margin: 0 0 12px;
  }

  .ai-team-experts-featured-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.featured_title_size }}px;
    color: {{ block.settings.accent_color }};
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 20px;
    display: block;
  }

  .ai-team-experts-featured-bio-{{ ai_gen_id }} {
    font-size: {{ block.settings.bio_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.7;
  }

  .ai-team-experts-divider-{{ ai_gen_id }} {
    height: 1px;
    background-color: {{ block.settings.divider_color }};
    margin: {{ block.settings.divider_spacing }}px 0;
    opacity: 0.2;
  }

  .ai-team-experts-specialists-{{ ai_gen_id }} {
    margin-top: {{ block.settings.specialists_spacing }}px;
  }

  .ai-team-experts-specialists-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.cards_spacing }}px;
  }

  .ai-team-experts-specialists-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.specialists_eyebrow_size }}px;
    color: {{ block.settings.eyebrow_color }};
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 12px;
    display: block;
  }

  .ai-team-experts-specialists-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.specialists_headline_size }}px;
    color: {{ block.settings.headline_color }};
    margin: 0;
  }

  .ai-team-experts-cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-team-experts-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    box-shadow: {{ block.settings.card_shadow_x }}px {{ block.settings.card_shadow_y }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity }});
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-team-experts-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: {{ block.settings.card_shadow_x }}px {{ block.settings.card_shadow_y | plus: 4 }}px {{ block.settings.card_shadow_blur | plus: 8 }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | times: 1.5 }});
  }

  .ai-team-experts-card-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .ai-team-experts-card-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-team-experts-card-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-team-experts-card-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-team-experts-card-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-team-experts-card-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_name_size }}px;
    color: {{ block.settings.headline_color }};
    font-weight: 700;
    margin: 0 0 8px;
  }

  .ai-team-experts-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.accent_color }};
    letter-spacing: 1px;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 12px;
    display: block;
  }

  .ai-team-experts-card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_description_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .ai-team-experts-card-link-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_link_size }}px;
    color: {{ block.settings.accent_color }};
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.3s ease;
  }

  .ai-team-experts-card-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.headline_color }};
  }

  .ai-team-experts-card-link-{{ ai_gen_id }}::after {
    content: '→';
    font-size: 16px;
  }

  @media screen and (max-width: 989px) {
    .ai-team-experts-featured-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-team-experts-featured-content-{{ ai_gen_id }} {
      padding: 0;
    }

    .ai-team-experts-cards-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-team-experts-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.7 }}px;
    }

    .ai-team-experts-specialists-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.specialists_headline_size | times: 0.7 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-team-experts-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px 16px {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }

    .ai-team-experts-cards-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-team-experts-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_size | times: 0.5 }}px;
    }

    .ai-team-experts-specialists-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.specialists_headline_size | times: 0.5 }}px;
    }

    .ai-team-experts-featured-name-{{ ai_gen_id }} {
      font-size: {{ block.settings.featured_name_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-team-experts-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-team-experts-container-{{ ai_gen_id }}">
    <div class="ai-team-experts-header-{{ ai_gen_id }}">
      {% if block.settings.eyebrow_text != blank %}
        <span class="ai-team-experts-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow_text }}</span>
      {% endif %}
      {% if block.settings.headline != blank %}
        <h2 class="ai-team-experts-headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h2>
      {% endif %}
      {% if block.settings.subheading != blank %}
        <div class="ai-team-experts-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
      {% endif %}
    </div>

    {% if block.settings.show_featured_member %}
      <div class="ai-team-experts-featured-{{ ai_gen_id }}">
        <div class="ai-team-experts-featured-image-{{ ai_gen_id }}">
          {% if block.settings.featured_image %}
            <img
              src="{{ block.settings.featured_image | image_url: width: 400 }}"
              alt="{{ block.settings.featured_name | escape }}"
              loading="lazy"
              width="400"
              height="500"
            >
          {% else %}
            <div class="ai-team-experts-featured-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        <div class="ai-team-experts-featured-content-{{ ai_gen_id }}">
          {% if block.settings.featured_name != blank %}
            <h3 class="ai-team-experts-featured-name-{{ ai_gen_id }}">{{ block.settings.featured_name }}</h3>
          {% endif %}
          {% if block.settings.featured_title != blank %}
            <span class="ai-team-experts-featured-title-{{ ai_gen_id }}">{{ block.settings.featured_title }}</span>
          {% endif %}
          {% if block.settings.featured_bio != blank %}
            <div class="ai-team-experts-featured-bio-{{ ai_gen_id }}">{{ block.settings.featured_bio }}</div>
          {% endif %}
        </div>
      </div>

      {% if block.settings.show_divider %}
        <div class="ai-team-experts-divider-{{ ai_gen_id }}"></div>
      {% endif %}
    {% endif %}

    <div class="ai-team-experts-specialists-{{ ai_gen_id }}">
      <div class="ai-team-experts-specialists-header-{{ ai_gen_id }}">
        {% if block.settings.specialists_eyebrow != blank %}
          <span class="ai-team-experts-specialists-eyebrow-{{ ai_gen_id }}">{{ block.settings.specialists_eyebrow }}</span>
        {% endif %}
        {% if block.settings.specialists_headline != blank %}
          <h3 class="ai-team-experts-specialists-headline-{{ ai_gen_id }}">{{ block.settings.specialists_headline }}</h3>
        {% endif %}
      </div>

      <div class="ai-team-experts-cards-{{ ai_gen_id }}">
        {% for i in (1..3) %}
          {% liquid
            assign card_image_key = 'card_' | append: i | append: '_image'
            assign card_name_key = 'card_' | append: i | append: '_name'
            assign card_title_key = 'card_' | append: i | append: '_title'
            assign card_description_key = 'card_' | append: i | append: '_description'
            assign card_link_key = 'card_' | append: i | append: '_link'

            assign card_image = block.settings[card_image_key]
            assign card_name = block.settings[card_name_key]
            assign card_title = block.settings[card_title_key]
            assign card_description = block.settings[card_description_key]
            assign card_link = block.settings[card_link_key]
          %}

          <div class="ai-team-experts-card-{{ ai_gen_id }}">
            <div class="ai-team-experts-card-image-{{ ai_gen_id }}">
              {% if card_image %}
                <img
                  src="{{ card_image | image_url: width: 600 }}"
                  alt="{{ card_name | escape }}"
                  loading="lazy"
                  width="600"
                  height="800"
                >
              {% else %}
                <div class="ai-team-experts-card-image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-team-experts-card-content-{{ ai_gen_id }}">
              {% if card_name != blank %}
                <h4 class="ai-team-experts-card-name-{{ ai_gen_id }}">{{ card_name }}</h4>
              {% endif %}
              {% if card_title != blank %}
                <span class="ai-team-experts-card-title-{{ ai_gen_id }}">{{ card_title }}</span>
              {% endif %}
              {% if card_description != blank %}
                <div class="ai-team-experts-card-description-{{ ai_gen_id }}">{{ card_description }}</div>
              {% endif %}
              {% if card_link != blank %}
                <a href="{{ card_link }}" class="ai-team-experts-card-link-{{ ai_gen_id }}">View Profile</a>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Our team of experts",
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow text",
      "default": "OUR TEAM OF EXPERTS"
