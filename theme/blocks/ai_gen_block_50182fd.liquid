    {
      "type": "header",
      "content": "Specialist 2"
    },
    {
      "type": "image_picker",
      "id": "card_2_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "card_2_name",
      "label": "Name",
      "default": "Scott Summers, MSc"
    },
    {
      "type": "text",
      "id": "card_2_title",
      "label": "Title",
      "default": "SENIOR ANALYST"
    },
    {
      "type": "textarea",
      "id": "card_2_description",
