{% doc %}
  @prompt
    Create a clean, modern “Mission” section with a two-column layout.
    
    LEFT COLUMN:
    - Add a rounded-corner photo of a diverse and friendly medical team in a bright clinical setting.
    - The image should take up about 45% of the width.
    - Use large rounded corners (20–30px).
    
    RIGHT COLUMN:
    - Add a small eyebrow label at the top: “OUR MISSION” in all caps with a subtle icon.
    - Add a bold, large headline: “Our mission is to help patients live better.”
    - Below the headline, create two short paragraphs that describe a healthcare or laboratory team dedicated to improving patient outcomes through advanced technology, expert analysis, and compassionate care.
    - Text tone should be professional, warm, and trustworthy.
    - Use clean, modern typography similar to a premium medical or laboratory brand.
    - Align all text left.
    - Add generous spacing so the layout feels airy and high-end.
    
    OVERALL STYLE:
    - White background.
    - Balanced padding around the entire section.
    - Subtle shadow or soft edges on the image for a polished, premium look.
    - Layout should mimic a hero-style horizontal split with image left and text right, similar to a healthcare landing page.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-mission-section-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-mission-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-mission-image-column-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.image_width }}%;
  }

  .ai-mission-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    box-shadow: {{ block.settings.image_shadow_x }}px {{ block.settings.image_shadow_y }}px {{ block.settings.image_shadow_blur }}px {{ block.settings.shadow_color }};
  }

  .ai-mission-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-mission-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 5;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-mission-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-mission-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-mission-content-column-{{ ai_gen_id }} {
    flex: 1;
    padding-left: {{ block.settings.content_padding }}px;
  }

  .ai-mission-eyebrow-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: {{ block.settings.eyebrow_spacing }}px;
  }

  .ai-mission-eyebrow-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    color: {{ block.settings.eyebrow_color }};
  }

  .ai-mission-eyebrow-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_font_size }}px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: {{ block.settings.eyebrow_color }};
  }

  .ai-mission-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_font_size }}px;
    font-weight: 700;
    line-height: 1.2;
    color: {{ block.settings.headline_color }};
    margin: 0 0 {{ block.settings.headline_spacing }}px 0;
  }

  .ai-mission-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_font_size }}px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
  }

  .ai-mission-description-{{ ai_gen_id }} p {
    margin: 0 0 {{ block.settings.paragraph_spacing }}px 0;
  }

  .ai-mission-description-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-mission-container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 40px;
    }

    .ai-mission-image-column-{{ ai_gen_id }} {
      flex: 0 0 100%;
      max-width: 500px;
    }

    .ai-mission-content-column-{{ ai_gen_id }} {
      padding-left: 0;
    }

    .ai-mission-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_font_size | times: 0.7 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-mission-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.6 }}px 16px;
    }

    .ai-mission-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_font_size | times: 0.5 }}px;
    }

    .ai-mission-eyebrow-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.eyebrow_font_size | times: 0.9 }}px;
    }

    .ai-mission-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-mission-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-mission-container-{{ ai_gen_id }}">
    <div class="ai-mission-image-column-{{ ai_gen_id }}">
      <div class="ai-mission-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 1000 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            class="ai-mission-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-mission-image-placeholder-{{ ai_gen_id }}">
            {{ 'hero-apparel-1' | placeholder_svg_tag }}
            <div class="ai-mission-empty-state-{{ ai_gen_id }}">
              Add an image of your medical team
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-mission-content-column-{{ ai_gen_id }}">
      {% if block.settings.show_eyebrow %}
        <div class="ai-mission-eyebrow-{{ ai_gen_id }}">
          {% if block.settings.show_icon %}
            <svg class="ai-mission-eyebrow-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          {% endif %}
          <span class="ai-mission-eyebrow-text-{{ ai_gen_id }}">{{ block.settings.eyebrow_text }}</span>
        </div>
      {% endif %}

      {% if block.settings.headline != blank %}
        <h2 class="ai-mission-headline-{{ ai_gen_id }}">{{ block.settings.headline }}</h2>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-mission-description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
