{% doc %}
  @prompt
    can you make a 3 column layout all have an image same size as the one you did before, below the image is the same header and subheading you did before
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-three-column-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-three-column-container-{{ ai_gen_id }} {
  width: 100%;
  margin: 0;
  padding: 0;
}


  .ai-three-column-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-three-column-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
  }

.ai-three-column-image-{{ ai_gen_id }} {
  width: 350px;
  height: 500px;
  display: block;
  object-fit: cover;
  border-radius: {{ block.settings.image_border_radius }}px;
   margin-bottom: {{ block.settings.image_text_spacing }}px;
}


.ai-three-column-image-{{ ai_gen_id }} {
  width: 400;
  height: 600;
  display: block;
  object-fit: cover;
  border-radius: {{ block.settings.image_border_radius }}px;
}

.ai-three-column-image-placeholder-{{ ai_gen_id }} {
  width: 100%;
  height: 100%;
  background-color: #f4f4f4;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: {{ block.settings.image_border_radius }}px;
}


  .ai-three-column-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-three-column-content-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-three-column-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-weight: 600;
  }

  .ai-three-column-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 989px) {
    .ai-three-column-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-three-column-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.column_gap | times: 1.5 }}px;
    }

    .ai-three-column-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.7 }}px 0;
    }
  }
{% endstyle %}

<div class="ai-three-column-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-three-column-container-{{ ai_gen_id }}">
    <div class="ai-three-column-grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign heading_key = 'heading_' | append: i
          assign subheading_key = 'subheading_' | append: i
          
          assign image = block.settings[image_key]
          assign heading = block.settings[heading_key]
          assign subheading = block.settings[subheading_key]
        %}
        
        <div class="ai-three-column-item-{{ ai_gen_id }}">
          <div class="ai-three-column-image-wrapper-{{ ai_gen_id }}">
            {% if image %}
              <img
                src="{{ image | image_url: width: 600 }}"
                alt="{{ image.alt | escape }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
                class="ai-three-column-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-three-column-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          
          <div class="ai-three-column-content-{{ ai_gen_id }}">
            {% if heading != blank %}
              <h3 class="ai-three-column-heading-{{ ai_gen_id }}">{{ heading }}</h3>
            {% endif %}
            
            {% if subheading != blank %}
              <div class="ai-three-column-subheading-{{ ai_gen_id }}">{{ subheading }}</div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Three column layout",
  "settings": [
    {
      "type": "header",
      "content": "Column 1"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading_1",
      "label": "Heading",
      "default": "Column 1"
    },
    {
      "type": "textarea",
      "id": "subheading_1",
      "label": "Subheading",
      "default": "Add a description for this column"
    },
    {
      "type": "header",
      "content": "Column 2"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Heading",
      "default": "Column 2"
    },
    {
      "type": "textarea",
      "id": "subheading_2",
      "label": "Subheading",
      "default": "Add a description for this column"
    },
    {
      "type": "header",
      "content": "Column 3"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading_3",
      "label": "Heading",
      "default": "Column 3"
    },
    {
      "type": "textarea",
      "id": "subheading_3",
      "label": "Subheading",
      "default": "Add a description for this column"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Column gap",
      "default": 30
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Section padding",
      "default": 50
    },
    {
      "type": "range",
      "id": "image_text_spacing",
      "min": 5,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Image to text spacing",
      "default": 20
    },
    {
      "type": "header",
      "content": "Image style"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Text style"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 14,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 24
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "label": "Heading spacing",
      "default": 10
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 12,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Subheading size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading",
      "default": "#666666"
    }
  ],
  "presets": [
    {
      "name": "Three column layout"
    }
  ]
}
{% endschema %}
