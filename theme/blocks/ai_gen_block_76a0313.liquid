{% doc %}
  @prompt
    Create a “Meet Our Specialists” section with a clean, modern medical design.
    
    SECTION STYLE:
    - Full-width background in a deep blue tone with subtle abstract waves or curves.
    - Centered heading group at the top.
    - Small eyebrow label: “OUR DOCTORS”
    - Large headline: “Meet Our Specialists”
    - White text for headings.
    
    LAYOUT:
    - Three evenly spaced profile cards in one row.
    - Cards should have:
      - White background
      - Soft round corners (20–25px)
      - Subtle shadow for depth
      - Vertical layout inside each card
    
    CARD CONTENTS:
    For each card include:
    - A professional doctor portrait with a light, neutral background.
    - Name in bold (e.g., “Dr. Wilbert Fletcher”)
    - Title line below (e.g., “Dermatologist, DCRT (UK)”)
    - A short placeholder description (one small line).
    - A “View Profile →” link at the bottom.
    
    SPACING:
    - Equal spacing between cards.
    - Generous vertical padding above and below the section.
    - Content centered and balanced like a premium medical website.
    
    OVERALL TONE:
    - Clean, trustworthy, professional.
    - Inspired by high-end healthcare website designs.
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-specialists-section-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  .ai-specialists-section-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: {{ block.settings.wave_overlay_color }};
    opacity: {{ block.settings.wave_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  .ai-specialists-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .ai-specialists-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-specialists-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    color: {{ block.settings.eyebrow_color }};
    letter-spacing: 2px;
    font-weight: 600;
    margin-bottom: 12px;
    display: block;
  }

  .ai-specialists-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    font-weight: 700;
    line-height: 1.2;
  }

  .ai-specialists-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.card_gap }}px;
    margin-top: {{ block.settings.grid_top_spacing }}px;
  }

  .ai-specialist-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    box-shadow: {{ block.settings.card_shadow_x }}px {{ block.settings.card_shadow_y }}px {{ block.settings.card_shadow_blur }}px {{ block.settings.card_shadow_color }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .ai-specialist-card-{{ ai_gen_id }}:hover {
    transform: translateY(-8px);
    box-shadow: {{ block.settings.card_shadow_x }}px {{ block.settings.card_shadow_y | plus: 8 }}px {{ block.settings.card_shadow_blur | plus: 10 }}px {{ block.settings.card_shadow_color }};
  }

  .ai-specialist-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .ai-specialist-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-specialist-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-specialist-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-specialist-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .ai-specialist-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.name_size }}px;
    color: {{ block.settings.name_color }};
    font-weight: 700;
    margin: 0 0 8px 0;
    line-height: 1.3;
  }

  .ai-specialist-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px 0;
    line-height: 1.4;
  }

  .ai-specialist-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
    margin: 0 0 20px 0;
    flex-grow: 1;
  }

  .ai-specialist-link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: {{ block.settings.link_color }};
    font-size: {{ block.settings.link_size }}px;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.3s ease, gap 0.3s ease;
  }

  .ai-specialist-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
    gap: 12px;
  }

  .ai-specialist-link-{{ ai_gen_id }} svg {
    width: 16px;
    height: 16px;
    transition: transform 0.3s ease;
  }

  .ai-specialist-link-{{ ai_gen_id }}:hover svg {
    transform: translateX(4px);
  }

  @media screen and (max-width: 989px) {
    .ai-specialists-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-specialists-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-specialists-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px 16px {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }

    .ai-specialists-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.card_gap | times: 0.7 }}px;
    }

    .ai-specialists-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.5 }}px;
    }

    .ai-specialist-content-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-specialists-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-specialists-container-{{ ai_gen_id }}">
    <div class="ai-specialists-header-{{ ai_gen_id }}">
      {% if block.settings.eyebrow_text != blank %}
        <span class="ai-specialists-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow_text }}</span>
      {% endif %}
      {% if block.settings.heading != blank %}
        <h2 class="ai-specialists-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
    </div>

    <div class="ai-specialists-grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'specialist_' | append: i | append: '_image'
          assign name_key = 'specialist_' | append: i | append: '_name'
          assign title_key = 'specialist_' | append: i | append: '_title'
          assign description_key = 'specialist_' | append: i | append: '_description'
          assign link_key = 'specialist_' | append: i | append: '_link'

          assign specialist_image = block.settings[image_key]
          assign specialist_name = block.settings[name_key]
          assign specialist_title = block.settings[title_key]
          assign specialist_description = block.settings[description_key]
          assign specialist_link = block.settings[link_key]
        %}

        <div class="ai-specialist-card-{{ ai_gen_id }}">
          <div class="ai-specialist-image-wrapper-{{ ai_gen_id }}">
            {% if specialist_image %}
              <img
                src="{{ specialist_image | image_url: width: 600 }}"
                alt="{{ specialist_name | escape }}"
                loading="lazy"
                width="600"
                height="600"
                class="ai-specialist-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-specialist-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-specialist-content-{{ ai_gen_id }}">
            {% if specialist_name != blank %}
              <h3 class="ai-specialist-name-{{ ai_gen_id }}">{{ specialist_name }}</h3>
            {% endif %}

            {% if specialist_title != blank %}
              <p class="ai-specialist-title-{{ ai_gen_id }}">{{ specialist_title }}</p>
            {% endif %}

            {% if specialist_description != blank %}
              <div class="ai-specialist-description-{{ ai_gen_id }}">{{ specialist_description }}</div>
            {% endif %}

            {% if specialist_link != blank %}
              <a href="{{ specialist_link }}" class="ai-specialist-link-{{ ai_gen_id }}">
                {{ block.settings.link_text }}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

