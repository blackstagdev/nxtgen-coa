            "open": false
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "Who is this testing for?",
            "answer": "<ul><li>Research Institutions – Supporting academic and clinical research projects. </li><li>Biotech & Pharma Companies – Helping ensure product quality before market release. </li><li>Manufacturers & Suppliers – Verifying peptide quality for customer confidence. </li><li>Independent Labs – Providing specialized testing on-demand. </li></ul>",
            "open": false
