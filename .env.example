# Copy to app/.env for local development (never commit real values).
# In production these are set in Render (see render.yaml).

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Postgres. Local without Postgres: `npm run db:local` then use the line below with DATABASE_POOL_MAX=1
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
DATABASE_POOL_MAX=1
DATABASE_SSL=false

# Secrets (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-with-a-long-random-string-of-32-plus-characters
TOKEN_ENC_KEY=replace-with-base64-32-byte-key
SESSION_TTL_HOURS=12

# Storage: "local" (development only, files in app/.local-storage) or "r2"
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=nga-coa-private
R2_PUBLIC_BUCKET=nga-coa-public
# OPTIONAL custom domain of the PUBLIC bucket (needs the domain on Cloudflare). Leave unset to serve
# published images from the app itself at <APP_URL>/coa-assets.
# PUBLIC_ASSET_BASE_URL=

# Shopify app (Dev Dashboard). Leave empty locally unless testing the proxy.
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_customers
SHOPIFY_API_VERSION=2026-07
# Optional: an Admin API token with read_customers instead of the OAuth install
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Development only: accept unsigned /proxy requests (ignored when NODE_ENV=production)
DEV_ALLOW_UNSIGNED_PROXY=false

# Optional one-time bootstrap of the first administrator (ignored once any user exists)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_PASSWORD=

UPLOAD_MAX_BYTES=8388608
