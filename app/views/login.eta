<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Sign in · NxtGen Analysis COA Console</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@500;700&family=Red+Hat+Text:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="/admin/assets/admin.css">
</head>
<body>
<main class="auth">
  <div class="auth__card">
    <span class="brand__mark">nxt<span>gen</span></span>
    <p class="eyebrow" data-mt="xs">COA Console · Staff sign-in</p>
    <h1>Sign in</h1>
    <% if (it.flash) { %><div class="alert alert--<%= it.flash.type === 'error' ? 'error' : 'success' %>" role="status"><p><%= it.flash.message %></p></div><% } %>
    <% if (it.error) { %><div class="alert alert--error" role="alert"><p><%= it.error %></p></div><% } %>
    <form method="post" action="/admin/login" novalidate>
      <input type="hidden" name="next" value="<%= it.next %>">
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="username" required value="<%= it.email %>" autofocus>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>
      </div>
      <button class="btn btn--primary btn--block" type="submit">Sign in</button>
      <p class="field__help">Access is limited to authorised NxtGen Analysis staff. Accounts are created by an administrator.</p>
    </form>
  </div>
</main>
</body>
</html>
