<% layout('./layout') %>
<div class="page-head"><div><p class="eyebrow">Account</p><h1><%= it.user.name %></h1><p><%= it.user.email %> · <%= it.user.role %></p></div></div>
<section class="panel" data-w="sm">
  <h2>Change password</h2>
  <% if (it.error) { %><div class="alert alert--error" role="alert"><p><%= it.error %></p></div><% } %>
  <form method="post" action="/admin/account/password" class="inline-form">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <div class="field"><label for="cur">Current password</label><input id="cur" name="current_password" type="password" autocomplete="current-password" required></div>
    <div class="field"><label for="new">New password</label><input id="new" name="new_password" type="password" autocomplete="new-password" required aria-describedby="new-help"><p class="field__help" id="new-help">At least 12 characters, mixing letters with numbers or symbols. You will be signed out everywhere.</p></div>
    <div class="field"><label for="conf">Confirm new password</label><input id="conf" name="confirm_password" type="password" autocomplete="new-password" required></div>
    <div class="form-actions"><button class="btn btn--primary" type="submit">Change password</button></div>
  </form>
</section>
